---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import CurrentFocus from '../components/CurrentFocus.astro';
import Sculpture from '../components/Sculpture.astro';
import CreativeShortcut from '../components/CreativeShortcut.astro';
import AboutMe from '../components/AboutMe.astro';
import { getProjects } from '../lib/projects';
import { capabilities } from '../data/profile';
const projects = await getProjects();
---
<BaseLayout>
  <CreativeShortcut />
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="availability"><span class="status-dot" aria-hidden="true"></span> Open to software / AI internships</p>
          <h1 id="hero-heading">Software, with<br/>a sense of<br/><em>possibility.</em></h1>
          <p class="hero-intro">I'm Palash, a Computer Science Engineering student at VESIT. I turn curiosity into software, explore unfamiliar problems, and learn whatever the next idea needs.</p>
          <div class="hero-actions"><a class="button" href="#selected-work">Explore my work <Arrow /></a><a class="text-link" href="#contact">Get in touch <Arrow /></a></div>
        </div>
        <div class="hero-visual"><Sculpture eager /><p class="art-caption eyebrow">Curiosity has no fixed shape.</p></div>
      </div>
      <div class="hero-bottom"><a href="#about-me">Scroll to explore <Arrow direction="down" /></a><span>Mumbai, India · VESIT<br/>Sep 2024 — May 2028 expected</span></div>
    </div>
  </section>
  <AboutMe />
  <section class="section" id="selected-work" aria-labelledby="work-heading">
    <div class="container">
      <div class="section-heading" data-reveal><div><span class="eyebrow">02 / Projects</span><h2 id="work-heading">Curiosity, put to <em>work.</em></h2></div><p>Different problems.<br/>The same willingness to explore.</p></div>
      <div class="project-grid">{projects.map(project => <ProjectFeature project={project} />)}</div>
    </div>
  </section>
  <section class="section capabilities-section" aria-labelledby="capabilities-heading">
    <div class="container">
      <div class="section-heading" data-reveal><div><span class="eyebrow">03 / Capabilities</span><h2 id="capabilities-heading">A few ways I <em>build.</em></h2></div><a class="text-link" href="/journey/">More about my journey <Arrow /></a></div>
      <div class="capabilities-grid">{capabilities.map((item, index) => <article class="capability" data-reveal><span class="capability-index">0{index + 1}</span><h3><a href={item.href}>{item.name}</a></h3><p>{item.description}</p><p class="tools">{item.items.join(' · ')}</p></article>)}</div>
    </div>
  </section>
  <section class="creative-band" aria-labelledby="creative-heading"><div class="container creative-band-inner"><div><span class="eyebrow">04 / Beyond the code</span><h2 id="creative-heading">A different kind<br/>of <em>output.</em></h2></div><div><p>Video, visual direction, and generative experiments. A space for the other side of how I create.</p><a class="text-link" href="/playground/">Step into the playground <Arrow /></a></div></div></section>
  <section class="section" aria-label="Current projects"><div class="container"><CurrentFocus /></div></section>
</BaseLayout>
